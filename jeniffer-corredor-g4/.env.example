# SentinelPay Risk Engine - Variables de entorno

# Zona horaria por defecto para comercios sin timezone explicito
SENTINELPAY_DEFAULT_TIMEZONE=UTC

# Umbral de score para decision REJECT
SENTINELPAY_REJECT_THRESHOLD=50

# Umbral de score para decision REVIEW (score > este valor)
SENTINELPAY_REVIEW_THRESHOLD=0

# Ruta al archivo de configuracion de reglas (opcional)
SENTINELPAY_RULES_CONFIG=
