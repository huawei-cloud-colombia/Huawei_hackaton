# ─── GLM 5.2 (Huawei Cloud MaaS — OpenAI-compatible) ───────
# Obtén tu API key en la consola de Huawei Cloud MaaS
MAAS_API_KEY=
GLM_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
GLM_MODEL=glm-5.2

# ─── MongoDB ────────────────────────────────────────────────
# Coincide con docker-compose.yml
MONGO_URI=mongodb://atlas:atlasdev@localhost:27017/atlas?authSource=admin
MONGO_DB=atlas

# ─── Kafka ──────────────────────────────────────────────────
# Coincide con docker-compose.yml
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=atlas-backend
KAFKA_CONSUMER_GROUP_TRIAGE=atlas-triage
KAFKA_CONSUMER_GROUP_CORRELATION=atlas-correlation

# ─── Triage config ──────────────────────────────────────────
# Umbral de abstención: si confidence < este valor → requires_human_review=true
CONFIDENCE_THRESHOLD=0.60
# Máximos reintentos a GLM antes de degradar
MAX_RETRIES=3
# Concurrencia máxima de llamadas a GLM (Bono B)
GLM_MAX_CONCURRENCY=5
# Timeout de llamada a GLM en ms
GLM_TIMEOUT_MS=30000
# Puerto del backend
PORT=3001
