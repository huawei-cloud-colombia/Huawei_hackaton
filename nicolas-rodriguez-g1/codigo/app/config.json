{
  "model": "glm-5.2",
  "api_base_url": "http://149.232.135.126:4000/v1",
  "api_key_env_var": "GLM_API_KEY",
  "temperature": 0.1,
  "max_tokens": 1024,
  "timeout_seconds": 30,
  "max_retries": 3,
  "retry_backoff_base": 2,
  "retry_backoff_factor": 1,
